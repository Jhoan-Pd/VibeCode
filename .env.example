# ===== Base de datos (Supabase o Neon) =====
# URL que usa la APP en runtime (pooler / conexión agrupada).
# Supabase: puerto 6543 (transaction pooler). Añade ?sslmode=no-verify (ver README).
# Neon: la URL "pooled connection" con ?sslmode=require
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:6543/postgres?sslmode=no-verify"

# URL que usa la CLI de Prisma (db push / migrate). Conexión directa o "session pooler" (puerto 5432).
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres?sslmode=require"

# ===== Auth.js =====
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""
# OAuth App de GitHub (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ===== LLM =====
# Proveedor principal: gemini o groq
LLM_PROVIDER="gemini"
# Respaldo si el principal falla por cuota, caída o modelo inexistente.
# Por defecto es el otro proveedor (si tiene clave). "none" lo desactiva.
LLM_FALLBACK=""
# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Modelo configurable (los nombres cambian con el tiempo, revisa https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL="gemini-3.5-flash-lite"
# Groq (respaldo gratuito): clave en https://console.groq.com/keys, modelos en https://console.groq.com/docs/models
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
# Tiempo máximo por llamada al LLM (ms)
LLM_TIMEOUT_MS="50000"

# ===== Límites =====
# Tamaño máximo del código (caracteres). Se valida en cliente y en servidor.
NEXT_PUBLIC_MAX_CODE_CHARS="20000"
# Líneas por bloque cuando el código se divide para el LLM
LLM_CHUNK_LINES="120"
# Análisis NUEVOS por usuario y día (los que salen de la caché no cuentan)
DAILY_ANALYSIS_LIMIT="10"
# Consultas secundarias a la IA por usuario y día (regenerar, quiz nuevo, corregir diagrama, chat)
DAILY_AI_QUERIES_LIMIT="60"
# Zona horaria en la que se reinicia el contador diario
APP_TIMEZONE="America/Bogota"

# ===== Opcionales =====
# Token de GitHub (sin permisos) para subir el límite de la API al leer Gists
GITHUB_TOKEN=""
